Options -Indexes

AddType text/css .css
AddType application/javascript .js
AddType application/json .json
AddType image/svg+xml .svg

<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Content-Security-Policy "default-src * 'unsafe-inline' 'unsafe-eval' data: blob:;"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Sin RewriteBase y con rutas relativas: funciona tanto en la raíz
    # del dominio como en una subcarpeta (p. ej. public_html/14dest/)

    # Pasar la cabecera Authorization a PHP
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Bloquear archivos sensibles
    RewriteRule ^(\.env|composer\.(json|lock)|\.git) - [F,L]
    RewriteRule ^frontend/(src|node_modules|package(-lock)?\.json|vite\.config\.js) - [F,L]
    RewriteRule ^backend/ - [F,L]

    # 1. API → backend PHP
    RewriteRule ^api(/.*)?$ backend/public/index.php [QSA,END]

    # 2. Carpeta de la web → app Vue compilada
    RewriteRule ^$ frontend/dist/index.html [END]

    # 3. Todo lo demás (assets, iconos, geojson, sw.js...) → frontend/dist/
    #    excepto lo que ya es frontend/, backend/ o uploads/
    RewriteRule ^(?!frontend/|backend/|uploads/)(.+)$ frontend/dist/$1 [END]
</IfModule>

<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag log_errors On
    php_value upload_max_filesize 10M
    php_value post_max_size 12M
    php_value max_execution_time 30
    php_value memory_limit 128M
    php_flag session.cookie_httponly On
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css              "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/jpeg            "access plus 1 year"
    ExpiresByType image/png             "access plus 1 year"
    ExpiresByType image/webp            "access plus 1 year"
    ExpiresByType image/svg+xml         "access plus 1 year"
</IfModule>
